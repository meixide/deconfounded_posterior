# Settings of this run, so that the directory describes itself.
#
# post_draws is 4 chains x 2000 iterations with warmup at half, as
# slurm/01_support_recovery.sh sets them (--chains from cpus-per-task=4)
# and scripts/01_sim_support_recovery.R defaults them.  It is inferred from
# those two files, not recorded per replication: this run predates the
# bgi_post_draws column.  Runs after it carry the count in every row and do
# not need this file.
#
# The aggregator screens on divergences per draw, so without this number it
# falls back to demanding zero divergences, which is not the screen the
# published table used.
post_draws=4000
chains=4
iter=2000
model=gi_hd_slope
adapt_delta=unrecorded
ncp=unrecorded
n_task_files=40
#
# The prior on the free part of the conditional variance.  These runs predate
# the change of default and used the improper Jeffreys p(v) propto 1/v, under
# which the posterior is not integrable wherever the target Mahalanobis term can
# exceed every training one (tests/test_posterior_propriety.R exhibits the
# divergence).  Like post_draws, this is inferred and not recorded per
# replication: no SLURM script passes --v-prior-shape, and the default in
# R/fit_bgi.R at the time was 0.  The default is now inv_gamma(3, 2), the prior
# tests/test_sbc.R draws from and validates, so a run made today would record 3
# and 2 here.
v_prior_shape=0
v_prior_rate=0
