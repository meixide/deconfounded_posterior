# Settings of this run, so that the directory describes itself.
#
# Table 2 of the manuscript. This is the support-recovery study repeated under a
# proper prior, and it is the run the paper reports.
#
# post_draws is 4 chains x 2000 iterations with warmup at half, as
# slurm/01_support_recovery.sh sets them (--chains from cpus-per-task=4) and
# scripts/01_sim_support_recovery.R defaults them.
post_draws=4000
chains=4
iter=2000
model=gi_hd_slope
adapt_delta=0.99
ncp=1
n_task_files=40
#
# The prior on the free part of the conditional variance. inv_gamma(3, 2) is the
# package default and the prior tests/test_sbc.R draws from and validates. It is
# not passed as a flag: scripts/01_sim_support_recovery.R takes the default in
# R/fit_bgi.R, which is 3 and 2.
#
# results/support_recovery_ad99_slope is the same study under the improper
# Jeffreys prior that the default used to be. It is kept for comparison: 36 of
# 40 replications passed the screen there against 38 here, and the reported
# figures move by at most a hundredth.
v_prior_shape=3
v_prior_rate=2
